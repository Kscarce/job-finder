# Copy this file to keys/.env and fill in your own keys.
# keys/.env is listed in .gitignore, so your keys are never uploaded.

# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Subscribe to the free "Basic" plan, then copy the "X-RapidAPI-Key" value.
JSEARCH_API_KEY=

# USAJobs: https://developer.usajobs.gov/apirequest/
# The key is emailed to you. Use the same email address you signed up with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
